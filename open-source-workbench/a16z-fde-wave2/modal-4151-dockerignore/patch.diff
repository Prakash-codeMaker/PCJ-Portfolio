+@pytest.mark.parametrize("use_dockerfile", (True, False))
+@pytest.mark.usefixtures("tmp_cwd")
+def test_image_dockerfile_copy_auto_dockerignore_leading_slash_negation(builder_version, servicer, client, use_dockerfile):
+    Path("app.py").write_text("print('ok')\n")
+    Path("keep.txt").write_text("keep\n")
+    Path("drop.txt").write_text("drop\n")
+    dockerfile = Path("Dockerfile")
+    dockerfile.write_text("FROM python:3.12-slim\nCOPY . /app/\n")
+    Path(".dockerignore").write_text("*.txt\n!/keep.txt\n")
+
+    if use_dockerfile:
+        image = Image.from_dockerfile(dockerfile)
+        layer = 1 if builder_version <= "2025.06" else 0
+    else:
+        image = Image.debian_slim().dockerfile_commands(["COPY . /app/"])
+        layer = 0
+
+    build_image(image, client)
+    layers = get_image_layers(image.object_id, servicer)
+    mount_id = layers[layer].context_mount_id
+    files = {Path(fn) for fn in servicer.mount_contents[mount_id].keys()}
+    assert Path("/keep.txt") in files
+    assert Path("/drop.txt") not in files
+
+
