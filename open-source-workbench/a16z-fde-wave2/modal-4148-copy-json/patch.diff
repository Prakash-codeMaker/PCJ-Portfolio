+                # Docker supports JSON/exec-form COPY arguments as well as shell form.
+                # Parse leading flags separately so paths containing spaces remain intact.
+                flags_match = re.match(r"^((?:--[^\s]+\s+)*)(.*)$", args)
+                flags, remainder = flags_match.groups() if flags_match else ("", args)
+                try:
