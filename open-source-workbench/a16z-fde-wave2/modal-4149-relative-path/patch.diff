diff --git a/py/test/docker_utils_test.py b/py/test/docker_utils_test.py
index bccb0b7..0000000 100644
--- a/py/test/docker_utils_test.py
+++ b/py/test/docker_utils_test.py
@@ -120,1 +120,14 @@
         assert find_dockerignore_file(test_cwd / tmp_dir, dockerfile_path) == dockerignore_path
+
+
+@pytest.mark.usefixtures("tmp_cwd")
+def test_find_specific_dockerignore_file_with_relative_dockerfile_path():
+    test_cwd = Path.cwd()
+    project_dir = Path("project")
+    project_dir.mkdir()
+    dockerfile_path = project_dir / "Dockerfile"
+    dockerfile_path.write_text("")
+    specific_dockerignore = project_dir / "Dockerfile.dockerignore"
+    specific_dockerignore.write_text("**/*.py")
+
+    assert find_dockerignore_file(test_cwd, dockerfile_path) == test_cwd / specific_dockerignore
