             ...
+
+
+@pytest.mark.asyncio
+async def test_volume_cli_get_directory_to_nonexistent_destination(client, tmp_path):
+    await modal.Volume.objects.create.aio(
+        "volume-get-directory-regression", client=client, version=api_pb2.VOLUME_FS_VERSION_V2
+    )
+    volume = await modal.Volume.from_name("volume-get-directory-regression").hydrate.aio(client=client)
+    (tmp_path / "a.txt").write_text("alpha\n")
+    (tmp_path / "b.txt").write_text("beta\n")
+
+    async with volume.batch_upload() as batch:
+        batch.put_file(tmp_path / "a.txt", "directory-repro/a.txt")
+        batch.put_file(tmp_path / "b.txt", "directory-repro/b.txt")
+
+    destination = tmp_path / "download"
+    assert not destination.exists()
+
+    def progress_cb(**kwargs):
+        return 1
+
+    await _volume_download(
+        volume=volume,
+        remote_path="directory-repro",
+        local_destination=destination,
+        overwrite=False,
+        progress_cb=progress_cb,
+        concurrency=2,
+    )
+
+    assert destination.is_dir()
+    assert (destination / "a.txt").read_text() == "alpha\n"
+    assert (destination / "b.txt").read_text() == "beta\n"
