+def _volume_entry_output_path(remote_path: str, local_destination: Path, entry: FileEntry) -> tuple[Path, bool]:
+    """Map a Volume listing entry to its local output path.
+
+    A file request may use a new local filename. A directory request always maps
+    entries relative to the requested remote directory, regardless of whether the
+    local destination existed before the download started.
+    """
+    requested_path = PurePosixPath(remote_path.lstrip("/"))
+    entry_path = PurePosixPath(entry.path.lstrip("/"))
+
+    if local_destination.exists() and not local_destination.is_dir() and not (
+        entry.type == FileEntryType.FILE and entry_path == requested_path
+    ):
+        raise UsageError(f"Local destination '{local_destination}' must be a directory for a remote directory")
+
+    if entry_path == requested_path and entry.type == FileEntryType.DIRECTORY:
+        return local_destination, True
+
+    if entry_path == requested_path and entry.type == FileEntryType.FILE:
+        if local_destination.is_dir():
+            return local_destination / entry_path.name, False
+        return local_destination, False
+
+    try:
+        relative_path = entry_path.relative_to(requested_path)
+    except ValueError:
+        raise UsageError(
+            f"Volume listing returned '{entry.path}' outside requested directory '{remote_path}'"
+        ) from None
+    if relative_path.is_absolute() or ".." in relative_path.parts:
+        raise UsageError(f"Volume listing returned an unsafe relative path: '{entry.path}'")

+    return local_destination / Path(relative_path.as_posix()), False
+
