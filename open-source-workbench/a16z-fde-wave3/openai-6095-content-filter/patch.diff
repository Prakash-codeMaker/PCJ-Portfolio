diff --git a/src/agents/models/chatcmpl_helpers.py b/src/agents/models/chatcmpl_helpers.py
--- a/src/agents/models/chatcmpl_helpers.py
+++ b/src/agents/models/chatcmpl_helpers.py
@@ -45,4 +45,20 @@
     def is_openai(cls, client: AsyncOpenAI) -> bool:
         return is_official_openai_client(client)
 
+    @classmethod
+    def content_filter_refusal_message(cls, finish_reason: Any) -> str | None:
+        """Return refusal text for standard and provider-qualified content-filter reasons."""
+        if not isinstance(finish_reason, str):
+            return None
+        if finish_reason != "content_filter" and not finish_reason.startswith("content_filter:"):
+            return None
+
+        reason = finish_reason.partition(":")[2].strip()
+        if reason:
+            return f"Response withheld by the provider's content filter ({reason})."
+        return "Response withheld by the provider's content filter."
+
     @classmethod
     def get_store_param(cls, client: AsyncOpenAI, model_settings: ModelSettings) -> bool | None:
         # Match the behavior of Responses where store is True when not given
         default_store = True if cls.is_openai(client) else None
         return model_settings.store if model_settings.store is not None else default_store

